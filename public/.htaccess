# Apache config for the Procura SPA build (copied into dist/ by Vite).

# Client-side routes: serve index.html for any path that isn't a real file or folder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Hashed assets never change, so browsers may cache them for a year.
# index.html must always be revalidated so new deploys show up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
